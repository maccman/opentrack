{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".output/**", ".nitro/**"],
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "VERCEL_URL",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "WRITE_KEY",
        "OPENTRACK_ALLOW_UNAUTHENTICATED_INGEST",
        "OPENTRACK_ERASURE_SECRET",
        "OPENTRACK_SUPPRESSION_HASH_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "BIGQUERY_PROJECT_ID",
        "BIGQUERY_DATASET",
        "GOOGLE_APPLICATION_CREDENTIALS_JSON",
        "CUSTOMERIO_SITE_ID",
        "CUSTOMERIO_API_KEY",
        "CUSTOMERIO_REGION",
        "WEBHOOK_URL"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^build"]
    }
  }
}
